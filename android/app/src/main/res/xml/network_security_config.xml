<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置(V4-1 T22):回环预览口明文放行,域级白名单、非全域。

  原因(注钉):缩略图/预览流直连 daemon 惰性起的 127.0.0.1 回环口(Coil/
  OkHttp GET http://127.0.0.1:{port}/f/{handle}/thumb?w=…&t=…——预览口仅
  本机进程可达,凭据 = preview_open 发放的 port/token,T20 面查询令牌)。
  Android 9+ 默认禁明文,不放行 Coil 一律失败(缩略图全缺)。**只放行
  localhost/127.0.0.1 两域**——全域明文(usesCleartextTraffic="true")
  不得开:信令/更新/镜像拉取等其余流量仍强制 TLS,回环面无出网风险。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
