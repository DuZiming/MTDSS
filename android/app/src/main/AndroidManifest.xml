<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 信令/QUIC/STUN 出网(设计 §4.1);无前台服务、无通知 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络变化桥(r58):ConnectivityManager 显著变化监听(切网自愈
         network.changed 的宿主信号面;普通权限,无运行时请求) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫码登录相机(T12,V3-4 §4.9):运行时请求,拒绝 = 入口置灰+指路设置 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 照片桥存储权限(V3-4 §4.3 T14 权限矩阵;minSdk 29 无 ≤28 面):
         API 33+ = READ_MEDIA_IMAGES + READ_MEDIA_VIDEO 双权;
         API 29-32 = READ_EXTERNAL_STORAGE(MIX 3 冒烟机在此档)。
         权限即数据面:未授权 = PhotoResponder 不应答 → /照片图库 根隐藏;
         本波为 App 首次引入运行时存储权限(商店合规姿态变化记录在案)。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MtdssApplication"
        android:label="Synshu"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/SynshuTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 全屏预览(V4-1 T23):浏览行/磁贴/树行文件点入推入;黑底沉浸
             (图片 zoom/ExoPlayer 原流/WebView 文档 bundle)。深色主题 =
             沉浸面(状态栏深底);非导出 = 仅 App 内部调起 -->
        <!-- r70i:activity 级关硬件加速——MIX3(Chromium 83 + 老 Adreno +
             MIUI kernel 4.9)上 WebView 合成层不上屏(物理屏内容区恒黑,
             截图/录屏走软件重合成反而有内容;顶底 Compose 栏正常)。整
             activity 软件渲染 = WebView 强制绘入窗口位图必上屏;预览量级
             (pdf 2x 位图/文本/CPU 栅格)性能可容。 -->
        <activity
            android:name=".ui.preview.PreviewActivity"
            android:exported="false"
            android:theme="@style/SynshuTheme" />

        <!-- 系统分享入口(V3-4 §4.4 T15):SEND/SEND_MULTIPLE,type 任意;
             分享件立即拷入 App 私有暂存区(不持 content URI)→ 入队 →
             主 App 消费面桥式发送;失败行可重试(暂存转交可重试模型) -->
        <activity
            android:name=".send.ShareActivity"
            android:exported="true"
            android:label="发送到 Synshu">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 更新 APK 的安装器授权面(T12):app 私有 {filesDir}/updates/ 经
             content:// 授权系统安装器读(私有直路径安装器不可见);路径面
             见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
